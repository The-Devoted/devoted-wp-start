# Environment Variables
.env

# SSH deploy key used by db_utils.sh
/.ssh

# Local Utilities
util.sh

# Ignore database backups created by db_utils.sh.
/backups

# Ignore Caddy file server config on staging
Caddyfile

# Wordpress - ignore core, configuration, examples, uploads and logs.
# https://github.com/github/gitignore/blob/main/WordPress.gitignore
# --------------------------

# Core
#
# Note: if you want to stage/commit WP core files
# you can delete this whole section/until Configuration.
/wp-admin/
/wp-content/index.php
/wp-content/languages
/wp-content/plugins/index.php
/wp-content/themes/index.php
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# Configuration
wp-config.php

# Log files
*.log

# htaccess
.htaccess

# All plugins
/wp-content/plugins

# Plugin License Key Auths
auth.json

# Example themes
/wp-content/themes/twenty*/

# Uploads
/wp-content/uploads/

# Composer
# --------------------------
# Ignore Composer packages.
/vendor/
/wordpress/vendor/

# Ignore dependencies installed via npm.
# --------------------------
node_modules

# Compiled custom blocks.
# --------------------------
# Built from the theme's `src` directory via @wordpress/scripts (`npm run build`).
/wp-content/themes/devoted/build/

# Playwright e2e test output.
# --------------------------
/tests/e2e/test-results/
/tests/e2e/playwright-report/
/tests/e2e/.auth/

# Sass.
# --------------------------
.sass-cache/
*.css.map
*.sass.map
*.scss.map

# VSCode, linting, and developer preferences.
# --------------------------
/.vscode/
.stylelintrc

# OS generated files.
# --------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
