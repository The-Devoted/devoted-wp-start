{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "devoted/secondary-nav",
    "version": "0.1.0",
    "title": "Secondary Navigation",
    "category": "devoted-theme",
    "icon": "list-view",
    "description": "Displays the current page's section navigation: a link to the section's top-level page, then either a single-link trail through intermediate ancestors plus the current page's siblings (\"trail\", default), or the entire nested tree under the section root (\"full\").",
    "textdomain": "devoted",
    "usesContext": ["postId"],
    "supports": {
        "html": false,
        "color": {
            "background": true,
            "text": true
        },
        "spacing": {
            "padding": true
        }
    },
    "attributes": {
        "mode": {
            "type": "string",
            "enum": ["trail", "full"],
            "default": "trail"
        }
    },
    "example": {},
    "render": "file:./render.php",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css"
}
