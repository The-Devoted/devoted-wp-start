# General
PROJECT_NAME=enter_your_project_name

# Docker Images
# Adjust versions as needed by your project.
DOCKER_WORDPRESS_IMAGE=wordpress:7.0-php8.3-apache
DOCKER_DB_IMAGE=mariadb:noble
DOCKER_DB_GUI_IMAGE=phpmyadmin:latest

# WordPress
WORDPRESS_THEME_NAME=devoted
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_HOST=create_a_db_host
WORDPRESS_DB_USER=create_a_db_username
WORDPRESS_DB_PASSWORD=generate_a_db_password
WORDPRESS_DEBUG=true

# Database
MYSQL_ROOT_HOST='%'

# Digital Ocean Droplet
DO_DROPLET_HOST='enter_droplet_host_or_ip_here'
DO_DROPLET_USERNAME=enter_your_droplet_username
DOMAIN_NAME=enter_your_domain_name

# Remote Server (for db_utils.sh)
# The directory the app is checked out into on the droplet, relative to
# DO_DROPLET_USERNAME's home directory.
REMOTE_APP_DIR=enter_remote_app_directory_name

# Local Dev URL (for db_utils.sh)
LOCAL_URL=http://localhost:8000
